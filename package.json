{
  "name": "wy-argo-erp-monorepo",
  "version": "1.0.0",
  "description": "WY Argo Dairy ERP - Dairy Inventory, POS Sales, Expense Tracking & Cash Flow Management",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm start --prefix backend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": [
    "dairy",
    "erp",
    "inventory",
    "cashflow",
    "expenses",
    "rbac"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
